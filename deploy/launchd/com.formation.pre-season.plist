<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.formation.pre-season</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/scripts/run-data-job.sh</string>
		<string>pre-season</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<!-- 15 January, 06:00 local time (old cron: 06:00 UTC on the 15th). -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Month</key>
		<integer>1</integer>
		<key>Day</key>
		<integer>15</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__REPO__/logs/pre-season.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO__/logs/pre-season.log</string>
</dict>
</plist>
